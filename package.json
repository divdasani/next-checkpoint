{
  "name": "next-checkpoint",
  "private": true,
  "version": "1.0.0",
  "description": "Next Checkpoint: a small interactive resume world for Annika Dasani.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
